<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Solo para compilaciones de desarrollo (firma ad-hoc): las bibliotecas internas de PyInstaller
     tienen otro Team ID y, con hardened runtime, macOS no las cargaría sin esta excepción. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
